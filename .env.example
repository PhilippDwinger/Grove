# Vorlage: Kopiere diese Datei zu ".env" und trage deine Werte aus Supabase ein
# (Supabase → Project Settings → API). Die echte .env wird NIE hochgeladen.
#
# Nur Variablen mit "VITE_" am Anfang landen im Browser – also nur öffentliche Werte!
# Der "service_role"- bzw. "secret"-Key gehört NIEMALS hier hinein.

VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
